# .env.dev.example — committed reference for .devcontainer/.env.dev.
#
# Copy to `.env.dev` (gitignored) and fill in secrets. All values shown here are
# dev-environment defaults; rotate before prod. `docker compose` reads this file
# via env_file on every service, so it is the single source of truth for the
# dev stack (Medusa backend + storefront + Strapi CMS).

### Enviroment
BUILD_ENV=dev
NODE_VERSION=22
PYTHONUNBUFFERED=1
DATA_PATH=./data

### PostgreSQL (single source of truth — consumed by docker-compose.dev.yml postgres service)
# Applies on FIRST init of the postgres data dir (data/postgres).
# POSTGRES_DB=
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

### Git Repo 
GITHUB_USER=Your Name
GITHUB_EMAIL=you@example.com
GITHUB_TOKEN=<github-pat>
GITHUB_PROJECT=Waste0fTimee/PU-Community-Data-Preservation



### Admin Superuser
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=Admin12345


### Timezone
TZ=America/Lima

### VNC
ENABLE_VNC=true
DISPLAY=:3

### SEC-016: Patchright (stealth-patched Playwright fork)
PATCHRIGHT_ENABLED=true

### Browser locale
BROWSER_LOCALE=en-US

### Claude CODE
ANTHROPIC_AUTH_TOKEN=sk-
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-flash
ANTHROPIC_SMALL_FAST_MODEL=deepseek-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash