
{
  "name": "PU Community Data Preservation",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Frontend Development",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pnpm install && cd backend/python && uv sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        }
      }
    }
  },
  "remoteUser": "vscode"
}
